from plateau import Plateau
from voiture_rouge import Voiture_rouge
from voiture import Voiture

# Initialisation du plateau (basé sur Plateau_filip_V2)
taille = 6
Plateau = []

for ligne in range(taille):
    Plateau.append(["x"] * taille)

# Création et placement de la voiture rouge en ligne 2, colonne 1
voiture_R = Voiture_rouge(2, 1)

for i in range(voiture_R.taille):
    Plateau[voiture_R.coordonnees_x][voiture_R.coordonnees_y + i] = voiture_R.symbole

# Affichage initial du plateau (comme dans Plateau_filip_V2)
print("--- Plateau initial ---")
for ligne in range(taille):
    affichage = ""
    for colonne in range(taille):
        affichage = affichage + Plateau[ligne][colonne] + " "
    print(affichage)
