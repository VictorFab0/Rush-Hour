class Voiture:
    def __init__(self, couleur, taille, orientation, coordonnees_x, coordonnees_y):
        self.couleur = couleur
        self.symbole = "R"
        self.taille = 2
        self.orientation = "H"
        self.coordonnees_x = 2
        self.coordonnees_y = 0

    def avancer(self, nb_cases, plateau):
        for i in range(self.taille):
            plateau.grille[2][self.coordonnees_y + i] = "x"
        self.coordonnees_y = self.coordonnees_y + nb_cases
        for i in range(self.taille):
            plateau.grille[2][self.coordonnees_y + i] = "R"


class Plateau:
    def __init__(self):
        self.grille = []
        for i in range(6):
            self.grille.append(["x", "x", "x", "x", "x", "x"])

    def afficher(self):
        print("0 1 2 3 4 5")
        for i in range(6):
            print(self.grille[i][0], self.grille[i][1], self.grille[i][2], self.grille[i][3], self.grille[i][4], self.grille[i][5])

plateau = Plateau()
voiture_rouge = Voiture("rouge", 2, "H", 2, 0)

plateau.grille[2][0] = "R"
plateau.grille[2][1] = "R"

gagne = False

while gagne == False:
    plateau.afficher()
    mouvement = input("Quelle voiture voulez-vous déplacer ? ")

    if mouvement == "R" or mouvement == "r":
        direction = input("Dans quelle direction ? (gauche ou droite) ")

        if direction == "gauche":
            if voiture_rouge.coordonnees_y > 0:
                voiture_rouge.avancer(-1, plateau)
            else:
                print("Pas possible")

        if direction == "droite":
            if voiture_rouge.coordonnees_y < 4:
                voiture_rouge.avancer(1, plateau)
            else:
                print("Pas possible")
        else:
            print("Pas possible")
    else:
        print("Pas possible")

    if voiture_rouge.coordonnees_y == 4:
        gagne = True

plateau.afficher()
print("Vous avez gagné")
